# Kopie als backend/.env anlegen (die Datei wird nicht committet).
# Bei lokal laufendem Supabase stehen die Werte in `npx supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<ANON_KEY>

# Optional: nur für Admin-Funktionen (z. B. Einladungen per E-Mail)
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
